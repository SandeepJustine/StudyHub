// prisma/schema.prisma
// StudyHub Malawi — single source of truth for the data model.
// Reconciled with the application code (services + API routes + types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  SCHOOL_ADMIN
  INSTRUCTOR
  CORPORATE_CLIENT
  PLATFORM_ADMIN
  PARENT
}

enum SubscriptionTier {
  STUDENT_BASIC
  STUDENT_PREMIUM
  STUDENT_ANNUAL
  ICAM
  PROFESSIONAL_BOARD
  INSTITUTION_BRONZE
  INSTITUTION_SILVER
  INSTITUTION_GOLD
  INSTRUCTOR_FREE
  INSTRUCTOR_PRO
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  RECONCILED
}

enum PaymentMethod {
  AIRTEL_MONEY
  TNM_MPAMBA
  PAYCHANGU
  VISA
  MASTERCARD
  BANK_TRANSFER
  SCHOOL_INVOICE
}

enum CertificateType {
  DIGITAL
  PRINTED
  VERIFIED
}

enum CertificateDelivery {
  DIGITAL
  PRINTED
  BOTH
}

enum CertificatePaymentStatus {
  PENDING
  PAID
  FREE
}

model CertificateTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  designConfig  Json?    // layout, colors, fonts, positions
  createdBy     String   // userId
  createdByRole String   // PLATFORM_ADMIN, INSTRUCTOR, SCHOOL_ADMIN
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  certificates  Certificate[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CertificateSignature {
  id          String   @id @default(cuid())
  name        String
  title       String
  imageUrl    String   @db.Text
  type        String   // ADMIN, INSTRUCTOR, INSTITUTION
  relatedId   String   // userId or institutionId
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id])
  institutionId String?
  institution Institution? @relation(fields: [institutionId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tags          String[] @default([])
  reviewedBy    String?
  originalId    String?
}

model CertificateBranding {
  id            String   @id @default(cuid())
  institutionId String   @unique
  institution   Institution @relation(fields: [institutionId], references: [id])
  primaryColor  String?  @default("#1a1a2e")
  secondaryColor String? @default("#16213e")
  accentColor   String?  @default("#e94560")
  fontFamily    String?  @default("serif")
  logoUrl       String?  @db.Text
  sealUrl       String?  @db.Text
  customTemplate Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum ContentType {
  VIDEO
  AUDIO
  TEXT
  PDF
  SLIDES
  LINK
  LIVE_SESSION
  EMBED
  QUIZ
  ASSIGNMENT
  PAST_PAPER
}

// Generic payment status used by PaymentTransaction (unified with TransactionStatus).
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Users & accounts
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  passwordHash  String
  fullName      String
  role          UserRole
  avatar        String?
  locale        String   @default("en")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Security / account state
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)

  student        Student?
  schoolAdmin    SchoolAdmin?
  instructor     Instructor?
  corporateClient CorporateClient?
  parent         Parent?

  subscriptions  Subscription[]
  transactions   Transaction[]
  notifications  Notification[]
  supportTickets SupportTicket[]
  supportResponses SupportResponse[]
  auditLogs      AuditLog[]
  activityLogs   ActivityLog[]

  eventRegistrations EventRegistration[]
  forumThreads       ForumThread[]
  forumPosts         ForumPost[]    @relation("PostAuthor")
  createdForums      Forum[]
  forumSubscriptions ForumSubscription[]
  marketplaceListings MarketplaceListing[]
  referralsMade      Referral[]   @relation("Referrer")
  referralsReceived  Referral[]   @relation("Referred")

  emailVerified         DateTime?
  emailVerificationToken  String? @unique
  notificationPreferences Json?  // NotificationPreferences type
  lastLoginAt           DateTime?
  passwordResetToken   String?
  emailVerificationExpires DateTime?
  resetToken           String? @unique
  resetTokenExpiry     DateTime?
  passwordResetExpires DateTime?

  // Email tracking
  emailBounced          Boolean   @default(false)
  emailComplaints       Int       @default(0)
  unsubscribedAt        DateTime?

  @@index([email])
  @@index([phone])
}


model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  resource    String
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  timestamp   DateTime @default(now())

  @@index([userId, timestamp])
  @@index([action])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // NotificationType enum, e.g. PAYMENT, REMINDER, RESULT
  channels      String[] // ['EMAIL', 'SMS', 'PUSH']
  title         String
  message       String
  status        String   @default("pending")

  // Per-channel tracking
  emailSentAt   DateTime?
  emailStatus   String?  // delivered, bounced, opened, clicked, complained
  emailOpenedAt DateTime?
  emailClickedAt DateTime?

  smsSentAt     DateTime?
  smsStatus     String?  // delivered, failed, undelivered

  pushSentAt    DateTime?
  pushStatus    String?  // delivered, failed

  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

model EmailTemplate {
  id            String   @id @default(cuid())
  name          String   @unique
  subject       String
  htmlContent   String
  textContent   String?
  variables     String[] // ['userName', 'amount', etc.]
  locale        String   @default("en")
  version       Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Role profiles
// ---------------------------------------------------------------------------

model Student {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade         String?
  examBoard     String?  // MSCE, JCE, ICAM, TEVETA
  subjects      String[]
  wishlist      String[] @default([])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  parentLinks   ParentLink[]
  enrollments   Enrollment[]
  examAttempts  ExamAttempt[]
  certificates  Certificate[]
  jobApplications JobApplication[]
  courseReviews CourseReview[]
  ratings       InstructorRating[]
  assignmentSubmissions AssignmentSubmission[]
  studentExperiments StudentExperiment[]
  studentBadges StudentBadge[]
  virtualLabAttempts VirtualLabAttempt[]
}

model SchoolAdmin {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  role          String   // HEAD, TEACHER, etc.
}

model Instructor {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  expertise     String[]
  revenueShare  Float    @default(0.7) // 70% for free tier
  totalEarnings Int      @default(0)   // in MWK
  pendingEarnings Int    @default(0)   // in MWK — pending payout balance
  isVerified    Boolean  @default(false)  // ➕ ADD THIS
  bankDetails   Json?                      // ➕ ADD THIS (optional, for payout info)
  courses       Course[]
  payouts       Payout[]
  transactions  Transaction[]
  liveClasses   LiveClass[]

  // Aggregated counters (denormalized for performance)
  coursesCount  Int      @default(0)
  studentsCount Int      @default(0)
  rating        Float    @default(0)
  certificateSignatures CertificateSignature[]
  ratings       InstructorRating[]
}

model CorporateClient {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  industry      String?
  companySize   String?
  isVerified    Boolean  @default(false)  // ➕ ADD THIS
  logo          String?                   // ➕ ADD THIS (optional)
  contracts     CorporateContract[]
  jobPostings   RecruitmentPosting[]
}

model Parent {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneVerified Boolean  @default(false)
  parentLinks   ParentLink[]
}

model Institution {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  tier          SubscriptionTier @default(INSTITUTION_BRONZE)
  logo          String?
  primaryColor  String?
  accentColor   String?
  maxStudents   Int      @default(200)
  currentStudents Int    @default(0)
  address       String?
  contactPhone  String?
  contactEmail  String?
  website       String?
  isActive      Boolean  @default(true)
  settings      Json?
  createdAt     DateTime @default(now())

  students      Student[]
  admins        SchoolAdmin[]
  subscriptions Subscription[]
  branding      InstitutionBranding?
  certificateBranding CertificateBranding?
  certificateTemplates CertificateTemplate[]
  certificateSignatures CertificateSignature[]
}

model InstitutionBranding {
  id            String   @id @default(cuid())
  institutionId String   @unique
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  logo          String?
  primaryColor  String?
  accentColor   String?
  customCss     String?  @db.Text
  heroImage     String?
  tagline       String?
  updatedAt     DateTime @updatedAt
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])
  referredId   String
  referred     User     @relation("Referred", fields: [referredId], references: [id])
  code         String   @unique
  rewardType   String?  // e.g. SUBSCRIPTION_DAYS, CREDIT
  rewardAmount Int      @default(0)
  status       String   @default("pending") // pending, completed, rewarded
  completedAt  DateTime?
  refereeEmail String?
  convertedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([referrerId])
  @@index([referredId])
}

// ---------------------------------------------------------------------------
// Billing & payments
// ---------------------------------------------------------------------------

model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  tier          SubscriptionTier
  cycle         BillingCycle
  status        String   @default("active") // active, cancelled, expired
  amount        Int      // in MWK (integer)
  discountAmount Int?
  paymentMethod String?
  promoCode     String?
  metadata      Json?
  startDate     DateTime
  endDate       DateTime
  autoRenew     Boolean  @default(true)
  cancelledAt DateTime?
  createdAt     DateTime @default(now())

  transactions   Transaction[]
  invoices       Invoice[]

  @@index([userId, status])
  @@index([endDate])
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription  Subscription? @relation(fields: [subscriptionId], references: [id])
  amount        Int      // in MWK
  currency      String   @default("MWK")
  paymentMethod PaymentMethod
  status        TransactionStatus
  reference     String   @unique // external payment reference
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  // For revenue share tracking
  instructorId  String?
  instructor    Instructor? @relation(fields: [instructorId], references: [id])
  revenueSplit  Float?
  platformFee   Int?
  instructorPayout Int?   // Instructor's share of this transaction (in MWK)
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])

  // Provider reference (e.g. PayChangu charge_id)
  providerRef   String?
  // Refund tracking
  refundedAmount Int?
  refundedAt    DateTime?
  // Verification attempts
  attempts      Int      @default(0)

  eventRegistrations EventRegistration[]
  invoice        Invoice?

  @@index([userId, status])
  @@index([createdAt])
  @@index([instructorId])
}

// Unified payment transaction record used by PaymentService.
model PaymentTransaction {
  id              String         @id @default(cuid())
  userId          String
  amount          Int            // in MWK
  method          PaymentMethod
  status          PaymentStatus  @default(PENDING)
  description     String?
  providerTransactionId String?  @unique
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@index([providerTransactionId])
}

model Invoice {
  id              String   @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  transactionId   String?  @unique
  transaction     Transaction? @relation(fields: [transactionId], references: [id])
  invoiceNumber   String   @unique
  amount          Int
  status          String   @default("draft") // draft, paid, void, overdue
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([subscriptionId])
}

model Payout {
  id            String   @id @default(cuid())
  instructorId  String
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  amount        Int
  period        String   // e.g., "2026-07"
  status        String   @default("pending") // pending, paid, failed
  paidAt        DateTime?
  reference     String?
  paymentMethod String?  // e.g. AIRTEL_MONEY, TNM_MPAMBA, BANK_TRANSFER
  processedAt   DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Courses & content
// ---------------------------------------------------------------------------

model Course {
  id            String   @id @default(cuid())
  instructorId  String
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  subject       String
  examBoard     String?
  grade         String?
  price         Int      @default(0) // 0 = free/included in subscription
  status        ContentStatus @default(DRAFT)
  thumbnail     String?
  tags          String[] @default([])
  language      String   @default("en")
  duration      Int      @default(0) // total duration in seconds (denormalized)
  rating        Float    @default(0)
  reviewsCount  Int      @default(0)
  studentsCount Int      @default(0)
  publishedAt   DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  modules       CourseModule[]
  enrollments   Enrollment[]
  reviews       CourseReview[]
  forumThreads  ForumThread[]
  liveClasses   LiveClass[]
  transactions  Transaction[]
  experiments   Experiment[]
  virtualLabs       VirtualLab[]
  pastPapers        PastPaper[]
}

model PastPaper {
  id              String        @id @default(cuid())
  title           String
  subject         String
  examBoard       String
  grade           String?
  year            Int
  paperNumber     Int           @default(1)
  duration        Int           @default(180) // minutes
  fileUrl         String        @db.Text
  fileSize        Int?          // bytes
  contentType     String        @default("application/pdf") // application/pdf, application/msword, application/vnd.openxmlformats-officedocument.wordprocessingml.document
  markingSchemeUrl String?      @db.Text
  courseId        String?
  course          Course?       @relation(fields: [courseId], references: [id])
  uploadedBy      String        // userId
  status          ContentStatus @default(PENDING_REVIEW)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([subject])
  @@index([examBoard])
  @@index([year])
  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

model CourseReview {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  rating        Int      // 1-5
  comment       String?
  isAnonymous   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([courseId, studentId])
}

model InstructorRating {
  id            String   @id @default(cuid())
  instructorId  String
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  rating        Int      // 1-5
  comment       String?
  isAnonymous   Boolean @default(false)
  createdAt     DateTime @default(now())

  @@unique([instructorId, studentId])
}

model CourseModule {
  id              String      @id @default(cuid())
  courseId        String
  course          Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  order           Int
  contentType     ContentType @default(TEXT)
  contentUrl      String?     @db.Text
  contentData     Json?       // Stores all multimedia content metadata
  duration        Int?
  isPreview       Boolean     @default(false)
  isRequired      Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // New fields for multimedia support
  fileSize        Int?        // Size in bytes
  thumbnailUrl    String?
  transcriptUrl   String?
  captions        Json?       // Array of caption tracks
  embedCode       String?     @db.Text

  quiz            Quiz?
  assignments     Assignment[]
  progress        ModuleProgress[]
  experiments     Experiment[]
  virtualLabs     VirtualLab[]

  @@index([courseId, order])
}

model Assignment {
  id              String       @id @default(cuid())
  moduleId        String
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  instructions    String?
  dueDate         DateTime?
  maxScore        Int          @default(100)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  submissions     AssignmentSubmission[]

  @@index([moduleId])
}

model AssignmentSubmission {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student    @relation(fields: [studentId], references: [id])
  fileUrl       String?
  content       String?
  score         Float?
  feedback      String?
  submittedAt   DateTime   @default(now())
  gradedAt      DateTime?

  @@unique([assignmentId, studentId])
}

// Track student progress per module
model ModuleProgress {
  id              String       @id @default(cuid())
  enrollmentId    String
  enrollment      Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId        String
  module          CourseModule @relation(fields: [moduleId], references: [id])
  completed       Boolean      @default(false)
  progress        Float        @default(0)  // 0-100 for video/audio
  timeSpent       Int          @default(0)  // Seconds spent
  lastPosition    Float        @default(0)  // Last position for video/audio
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([enrollmentId, moduleId])
}

model Enrollment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  progress        Float    @default(0)
  totalModules    Int      @default(0)
  completedModules  String[] // Changed from Int to String[]
  startedAt       DateTime @default(now())
  lastAccessedAt  DateTime?
  completedAt     DateTime?
  certificateId   String? @unique
  enrolledAt      DateTime @default(now())

  moduleProgress ModuleProgress[]
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@unique([studentId, courseId])
}

model Quiz {
  id              String   @id @default(cuid())
  moduleId        String   @unique
  module          CourseModule @relation(fields: [moduleId], references: [id])
  title           String
  description     String?
  timeLimit       Int?     // minutes
  passingScore    Int      @default(60)
  maxAttempts     Int      @default(3)
  shuffleQuestions Boolean  @default(true)
  questionsCount  Int      @default(0)
  totalPoints     Int      @default(0)
  questions       Question[]
  examAttempts    ExamAttempt[]
  timeSpent       Int      @default(0)
}

model Question {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          String   @default("MULTIPLE_CHOICE") // QuestionType
  text          String
  options       Json?    // Array of {text, isCorrect}
  correctAnswer String?
  explanation   String?
  points        Int      @default(1)
  order         Int      @default(0)
}

model ExamAttempt {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id])
  score         Float
  passed        Boolean
  startedAt     DateTime
  completedAt   DateTime?
  answers       Json?    // Student's submitted answers
  attemptNumber Int      @default(1)
  timeSpent     Int      @default(0)

  certificate   Certificate?
}

model Certificate {
  id              String   @id @default(cuid())
  certificateNumber String @unique // CERT-2024-0001
  studentId       String
  student         Student @relation(fields: [studentId], references: [id])
  enrollment      Enrollment? @relation
  examAttemptId   String?  @unique
  examAttempt     ExamAttempt? @relation(fields: [examAttemptId], references: [id])
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id])
  type            CertificateType
  delivery        CertificateDelivery @default(DIGITAL)
  title           String
  description     String?
  verificationId  String @unique
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?
  paymentStatus   CertificatePaymentStatus @default(FREE)
  transactionId   String?
  amount          Int @default(0)
  issuedBy        String? // userId who issued it
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([studentId])
  @@index([verificationId])
  @@index([certificateNumber])
  @@index([templateId])
  @@index([issuedAt])
}

// ---------------------------------------------------------------------------
// Corporate & recruitment
// ---------------------------------------------------------------------------

model RecruitmentPosting {
  id            String   @id @default(cuid())
  clientId      String
  client        CorporateClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  description   String
  requirements  String?
  qualifications String?
  salary        String?
  location      String?
  type          String?  @default("Full-time")
  deadline      DateTime?
  status        String   @default("active")
  price         Int      @default(50000) // In MWK
  featured      Boolean  @default(false)
  urgent        Boolean  @default(false)
  applicationsCount Int @default(0)
  createdAt     DateTime @default(now())

  applications  JobApplication[]
}

model JobApplication {
  id            String   @id @default(cuid())
  postingId     String
  posting       RecruitmentPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  coverLetter   String?
  notes         String?
  cvUrl         String?
  appliedAt     DateTime @default(now())
  status        String   @default("pending")

  @@unique([postingId, studentId])
}

model CorporateContract {
  id            String   @id @default(cuid())
  clientId      String
  client        CorporateClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  employees     Int      @default(0)
  courses       Json     // Array of course packages
  totalAmount   Int
  status        String   @default("draft")
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Events & live classes
// ---------------------------------------------------------------------------

model Event {
  id            String   @id @default(cuid())
  title         String
  description   String?
  type          String   // BOOTCAMP, LIVE_CLASS
  date          DateTime
  venue         String?  // Physical location or virtual link
  capacity      Int
  price         Int      @default(5000) // MWK
  registered    Int      @default(0)
  status        String   @default("upcoming")
  recordingUrl  String?
  createdAt     DateTime @default(now())

  registrations EventRegistration[]
}

model EventRegistration {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  attended      Boolean  @default(false)
  status        String   @default("registered")
  attendedAt    DateTime?
  registeredAt  DateTime @default(now())

  @@unique([eventId, userId])
}

model LiveClass {
  id            String   @id @default(cuid())
  instructorId  String
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  subject       String?
  scheduledAt   DateTime
  duration      Int      @default(60) // minutes
  maxParticipants Int    @default(100)
  currentParticipants Int @default(0)
  status        String   @default("scheduled") // scheduled, live, ended, cancelled
  meetingUrl    String?
  meetingLink   String?  // Optional pre-shared link for participants
  recordingUrl  String?  @db.Text
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([instructorId, status])
}

// ---------------------------------------------------------------------------
// Community
// ---------------------------------------------------------------------------

model Forum {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  subject       String?  // e.g. Mathematics, Physics, English
  icon          String?
  color         String?  // Hex color for UI
  isPublic      Boolean  @default(true)
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  threads       ForumThread[]
  subscriptions ForumSubscription[]

  @@index([subject])
  @@index([slug])
}

model ForumSubscription {
  id            String   @id @default(cuid())
  forumId       String
  forum         Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String   @default("member") // member, moderator, admin
  createdAt     DateTime @default(now())

  @@unique([forumId, userId])
  @@index([userId])
}

model ForumThread {
  id            String   @id @default(cuid())
  forumId       String?
  forum         Forum?   @relation(fields: [forumId], references: [id])
  subject       String?
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  title         String
  content       String
  tags          String[] @default([])
  viewsCount    Int      @default(0)
  postsCount    Int      @default(0)
  isPinned      Boolean  @default(false)
  isLocked      Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())

  posts         ForumPost[]
}

model ForumPost {
  id        String   @id @default(cuid())
  content   String
  likes     Int      @default(0)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  authorId  String
  author    User         @relation("PostAuthor", fields: [authorId], references: [id])
  threadId  String
  thread    ForumThread  @relation(fields: [threadId], references: [id])
  parentId  String?
  parent    ForumPost?   @relation("PostReplies", fields: [parentId], references: [id])
  replies   ForumPost[]  @relation("PostReplies")

  @@index([threadId])
  @@index([authorId])
}


// ---------------------------------------------------------------------------
// Support

model SupportTicket {

  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String   // PAYMENT, ACCOUNT, CONTENT, TECHNICAL
  priority      String   @default("normal")
  subject       String
  description   String
  status        String   @default("open")
  assignedTo    String?
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  resolvedAt    DateTime?
  attachments   String[] @default([])

  responses     SupportResponse[]
}

model SupportResponse {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  message       String
  isInternal    Boolean  @default(false)
  attachments   String[] @default([])
  createdAt     DateTime @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Growth & marketing
// ---------------------------------------------------------------------------

model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  discount      Float    // Percentage or fixed amount
  type          String   // PERCENTAGE, FIXED
  maxUses       Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  applicableTiers SubscriptionTier[]
  createdBy     String?
  isActive      Boolean   @default(true)
  minAmount     Int?
  createdAt     DateTime @default(now())
}

model SponsorshipSlot {
  id            String   @id @default(cuid())
  sponsor       String
  type          String   // BANNER, WEBINAR, PROMOTED_COURSE, FEATURED_LISTING
  targetUrl     String?
  imageUrl      String?
  image         String?
  startDate     DateTime
  endDate       DateTime
  price         Int
  status        String   @default("active")
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  placement     String?  // HERO, SIDEBAR, COURSE_LIST, COURSE_DETAIL, BETWEEN_SECTIONS
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, type, startDate, endDate])
  @@index([placement])
}

model MarketplaceListing {
  id            String   @id @default(cuid())
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  price         Int
  category      String   // TEXTBOOKS, UNIFORMS, CALCULATORS
  commission    Float    @default(0.15) // 15% platform commission
  status        String   @default("active")
  stock         Int       @default(1)
  sold          Int       @default(0)
  salesCount    Int       @default(0)
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Audit & compliance
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(cuid())
  adminId       String
  admin         User     @relation(fields: [adminId], references: [id])
  action        String
  entity        String
  entityId      String
  changes       Json?
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Parent / guardian
// ---------------------------------------------------------------------------

model ParentLink {
  id            String   @id @default(cuid())
  parentId      String
  parent        Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  status        String   @default("active")
  relationship String?
  createdAt     DateTime @default(now())

  @@unique([parentId, studentId])
}

// ---------------------------------------------------------------------------
// Content items
// ---------------------------------------------------------------------------

model ContentItem {
  id            String   @id @default(cuid())
  title         String
  type          String   // LESSON, NOTES, PAST_PAPER
  subject       String
  examBoard     String
  grade         String?
  version       Int      @default(1)
  status        ContentStatus @default(PENDING_REVIEW)
  uploadedBy    String
  fileUrl       String?
  metadata      Json?
  tags          String[] @default([])
  reviewedBy    String?
  originalId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Virtual Lab (chemistry / physics / biology)
// ---------------------------------------------------------------------------

model Badge {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  icon          String?
  criteriaType  String   // experiment_count, score_threshold, specific_experiment
  criteriaValue Int
  createdAt     DateTime @default(now())

  studentBadges StudentBadge[]
}

model StudentBadge {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  badgeId       String
  badge         Badge    @relation(fields: [badgeId], references: [id])
  awardedAt     DateTime @default(now())

  @@unique([studentId, badgeId])
}

model Experiment {
  id            String   @id @default(cuid())
  title         String
  subject       String   @default("chemistry") // chemistry, physics, biology
  difficulty    String   @default("beginner") // beginner, intermediate, advanced
  description   String?
  objectives    String[]
  duration      Int      @default(30) // minutes
  xpReward      Int      @default(50)
  badgeId       String?
  status        String   @default("published") // draft, published, archived
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Assignment to courses and modules
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id])
  moduleId      String?
  module        CourseModule? @relation(fields: [moduleId], references: [id])

  steps         ExperimentStep[]
  attempts      StudentExperiment[]

  @@index([subject])
  @@index([difficulty])
  @@index([courseId])
  @@index([moduleId])
}

model ExperimentStep {
  id              String   @id @default(cuid())
  experimentId    String
  experiment      Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  order           Int
  instruction     String
  expectedAction  String?
  equipmentNeeded String[]
  chemicalNeeded  String?
  volume          Int?
  observationFields String[]
  hint            String?
  createdAt       DateTime @default(now())

  @@index([experimentId, order])
}

model StudentExperiment {
  id            String   @id @default(cuid())
  experimentId  String
  experiment    Experiment @relation(fields: [experimentId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  status        String   @default("not_started")
  startedAt     DateTime?
  completedAt   DateTime?
  score         Int      @default(0)
  xpEarned      Int      @default(0)
  observations  Json     @default("[]")
  currentStep   Int      @default(0)
  attempts      Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([studentId, status])
  @@index([experimentId])
}

model VirtualLab {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id])
  title       String
  description String?
  templateId  String
  labState    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts    VirtualLabAttempt[]

  @@index([courseId])
  @@index([moduleId])
}

model VirtualLabAttempt {
  id          String   @id @default(cuid())
  virtualLabId String
  virtualLab  VirtualLab @relation(fields: [virtualLabId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  status      String   @default("not_started")
  completedAt DateTime?
  score       Int      @default(0)
  xpEarned    Int      @default(0)
  observations Json    @default("[]")
  currentStep Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([virtualLabId])
}
