# Prisma Client generates into node_modules/.prisma/client and @prisma/client
# re-exports it via a relative path. With pnpm's isolated (symlinked) layout the
# generated client and the package that reads it resolve to different realpaths,
# so the client silently degrades to an `any` stub. A hoisted layout keeps both
# in the same node_modules and is required for both local builds and Docker.
node-linker=hoisted